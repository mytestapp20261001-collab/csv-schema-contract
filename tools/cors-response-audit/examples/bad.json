{
  "origin": "https://app.example",
  "credentials": "include",
  "preflight": true,
  "method": "PUT",
  "unsafe_request_headers": [
    "Authorization"
  ],
  "status": 403,
  "response_headers": [
    [
      "Access-Control-Allow-Origin",
      "*"
    ],
    [
      "Access-Control-Allow-Credentials",
      "True"
    ],
    [
      "Access-Control-Allow-Headers",
      "*"
    ]
  ]
}
